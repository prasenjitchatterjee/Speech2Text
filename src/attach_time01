from typing import List, Dict, Any

def attach_full_times_no_split(
    full_text: str,
    mapping: List[Dict[str, Any]],
    segments: List[Dict[str, Any]]
) -> List[Dict[str, Any]]:
    """
    Assign start_time_full / end_time_full to each segment strictly by its own [start_pos, end_pos)
    against the full transcript mapping. No splitting, no text changes, no channel spillover.

    mapping: list of dicts with keys: start_idx, end_idx, start_time, end_time
    segments: list of dicts with keys incl. start_pos, end_pos (others preserved)
    """

    def overlaps(a0: int, a1: int, b0: int, b1: int) -> bool:
        # half-open intervals [a0,a1) and [b0,b1)
        return not (a1 <= b0 or a0 >= b1)

    out: List[Dict[str, Any]] = []

    for seg in segments:
        s = seg.get("start_pos", -1)
        e = seg.get("end_pos", -1)

        start_time_full = -1
        end_time_full   = -1

        if (
            isinstance(s, int) and isinstance(e, int) and
            s != -1 and e != -1 and e > s
        ):
            # gather overlapped full rows in order
            ov = [m for m in mapping if overlaps(s, e, m["start_idx"], m["end_idx"])]

            if ov:
                first = ov[0]
                last  = ov[-1]
                st = first.get("start_time", None)
                et = last.get("end_time", None)
                start_time_full = st if isinstance(st, (int, float)) else -1
                end_time_full   = et if isinstance(et, (int, float)) else -1

        new_seg = dict(seg)
        new_seg["start_time_full"] = start_time_full
        new_seg["end_time_full"]   = end_time_full
        out.append(new_seg)

    return out
