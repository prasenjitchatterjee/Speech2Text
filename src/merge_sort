from typing import List, Dict, Any
import unicodedata

def _strip_diacritics(s: str) -> str:
    return ''.join(ch for ch in unicodedata.normalize('NFD', s)
                   if unicodedata.category(ch) != 'Mn')

def _norm_text(s: str) -> str:
    # diacritics/punct/space-insensitive, casefolded, multilingual-safe
    s = _strip_diacritics(s or "")
    return ''.join(ch for ch in s if ch.isalnum()).casefold()

def _pos_overlap(a: Dict[str, Any], b: Dict[str, Any]) -> float:
    """Return overlap ratio in char index space based on start_pos/end_pos."""
    sa, ea = a.get("start_pos", -1), a.get("end_pos", -1)
    sb, eb = b.get("start_pos", -1), b.get("end_pos", -1)
    if not (isinstance(sa, int) and isinstance(ea, int) and sa != -1 and ea != -1 and ea > sa):
        return 0.0
    if not (isinstance(sb, int) and isinstance(eb, int) and sb != -1 and eb != -1 and eb > sb):
        return 0.0
    inter = max(0, min(ea, eb) - max(sa, sb))
    min_len = max(1, min(ea - sa, eb - sb))
    return inter / min_len

def _time_overlap_full(a: Dict[str, Any], b: Dict[str, Any]) -> float:
    """Return overlap ratio in full timeline space (start_time_full/end_time_full)."""
    sa, ea = a.get("start_time_full", -1), a.get("end_time_full", -1)
    sb, eb = b.get("start_time_full", -1), b.get("end_time_full", -1)
    if any(v == -1 for v in (sa, ea, sb, eb)):
        return 0.0
    inter = max(0.0, min(ea, eb) - max(sa, sb))
    min_len = max(1e-9, min(ea - sa, eb - sb))
    return inter / min_len

def _prefer(a: Dict[str, Any], b: Dict[str, Any]) -> Dict[str, Any]:
    """
    Decide which duplicate to keep based on:
      1) has valid start_pos
      2) has valid full times
      3) longer text
      4) channel tie-break (left wins for determinism)
    """
    avp = a.get("start_pos", -1) != -1
    bvp = b.get("start_pos", -1) != -1
    if avp != bvp:
        return a if avp else b

    avt = (a.get("start_time_full", -1) != -1 and a.get("end_time_full", -1) != -1)
    bvt = (b.get("start_time_full", -1) != -1 and b.get("end_time_full", -1) != -1)
    if avt != bvt:
        return a if avt else b

    la = len(a.get("text", "") or "")
    lb = len(b.get("text", "") or "")
    if la != lb:
        return a if la >= lb else b

    # deterministic tie-break: left over right
    cha = (a.get("channel", "") or "").lower()
    chb = (b.get("channel", "") or "").lower()
    if cha != chb:
        return a if cha == "left" else b
    return a  # stable

def _dedupe_overlaps(sorted_items: List[Dict[str, Any]],
                     overlap_threshold: float = 0.7,
                     text_sim_threshold: float = 0.8) -> List[Dict[str, Any]]:
    """
    Remove cross-channel duplicates:
      - strong positional OR full-time overlap
      - and high text similarity
    """
    out: List[Dict[str, Any]] = []
    # precompute normalized texts
    norm = [_norm_text(it.get("text", "") or "") for it in sorted_items]

    def text_sim(i: int, j: int) -> float:
        # simple containment-based similarity
        if not norm[i] or not norm[j]:
            return 0.0
        a, b = norm[i], norm[j]
        if a in b or b in a:
            return min(len(a), len(b)) / max(len(a), len(b))
        # fallback: overlap by longest common prefix/suffix could be added; keep simple/fast:
        return 0.0

    taken = [False] * len(sorted_items)
    for i in range(len(sorted_items)):
        if taken[i]:
            continue
        keep = sorted_items[i]
        for j in range(i + 1, len(sorted_items)):
            if taken[j]:
                continue
            # only consider cross-channel collisions
            if (sorted_items[i].get("channel", "") or "").lower() == (sorted_items[j].get("channel", "") or "").lower():
                continue

            ovp = _pos_overlap(sorted_items[i], sorted_items[j])
            ovt = _time_overlap_full(sorted_items[i], sorted_items[j])
            sim = text_sim(i, j)

            if (ovp >= overlap_threshold or ovt >= overlap_threshold) and sim >= text_sim_threshold:
                # choose one to keep
                keep = _prefer(keep, sorted_items[j])
                taken[j] = True

        out.append(keep)
        taken[i] = True

    return out

def merge_and_sort_transcripts(
    left_channel: List[Dict[str, Any]],
    right_channel: List[Dict[str, Any]],
    left_channel_speaker: str = "Agent",
    right_channel_speaker: str = "Customer"
) -> List[Dict[str, Any]]:
    """
    Merge L/R transcripts, sort, then reconcile cross-channel duplicates.
    Sorting priority:
      1. start_pos (if available)
      2. start_time_full (midpoint)
      3. start_time (midpoint)
    """
    merged = []
    for entry in left_channel + right_channel:
        e = dict(entry)  # shallow copy

        # Ensure numeric fields
        for k in ["start_pos", "end_pos", "start_time_full", "end_time_full", "start_time", "end_time"]:
            e[k] = e.get(k, -1)
            if e[k] is None:
                e[k] = -1

        # composite sort key
        pos_score = e["start_pos"] if e["start_pos"] != -1 else float("inf")
        full_score = ((e["start_time_full"] + e["end_time_full"]) / 2
                      if e["start_time_full"] != -1 and e["end_time_full"] != -1 else float("inf"))
        chan_score = ((e["start_time"] + e["end_time"]) / 2
                      if e["start_time"] != -1 and e["end_time"] != -1 else float("inf"))
        e["_sort_key"] = (pos_score, full_score, chan_score)

        merged.append(e)

    # Sort
    merged.sort(key=lambda x: x["_sort_key"])

    # De-duplicate cross-channel overlaps AFTER sorting
    merged = _dedupe_overlaps(merged, overlap_threshold=0.7, text_sim_threshold=0.8)

    # Assign sequence + speaker and drop _sort_key
    for i, item in enumerate(merged, start=1):
        item["sequence"] = i
        ch = (item.get("channel", "") or "").lower()
        if ch == "left":
            item["speaker"] = left_channel_speaker
        elif ch == "right":
            item["speaker"] = right_channel_speaker
        else:
            item["speaker"] = "Unknown"
        item.pop("_sort_key", None)

    return merged
